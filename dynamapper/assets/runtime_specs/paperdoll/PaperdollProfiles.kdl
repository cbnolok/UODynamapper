// Classic Client paperdoll composition profiles.
//
// equipment_offset is added to tiledata/item tile anim_id to select the wearable gump.
// fallback_equipment_offset (optional) selects the gump drawn when that one is missing: the female profiles fall back to
// the male gumps, as ClassicUO and the Enhanced Client's gump paperdoll do. A gump missing after that leaves out only its
// layer, with a log line.
// body is the server body: the Enhanced 3D paperdoll draws its frame, and its race picks the race overrides of the
// WearableRules.kdl draw order.
// canvas_* is the minimum output surface size. body_* and equipment_* are draw origins.
// Custom shards can add body/race variants here without changing renderer code.
//
// Dynamapper reads your copy, cache/runtime_specs/paperdoll/PaperdollProfiles.kdl beside the assets folder, in place of
// this file when it exists; a copy that does not read is not used, with a warning, and this file applies until it is
// fixed. The uocf editor builds this file in; both decode it with uocf::classic::paperdoll_profiles.

profile "human_male" label="Human Male" equipment_offset=50000 body=400 canvas_width=260 canvas_height=300 body_x=0 body_y=0 equipment_x=0 equipment_y=0
profile "human_female" label="Human Female" equipment_offset=60000 fallback_equipment_offset=50000 body=401 canvas_width=260 canvas_height=300 body_x=0 body_y=0 equipment_x=0 equipment_y=0
profile "elf_male" label="Elf Male" equipment_offset=50000 body=605 canvas_width=260 canvas_height=300 body_x=0 body_y=0 equipment_x=0 equipment_y=0
profile "elf_female" label="Elf Female" equipment_offset=60000 fallback_equipment_offset=50000 body=606 canvas_width=260 canvas_height=300 body_x=0 body_y=0 equipment_x=0 equipment_y=0
profile "gargoyle_male" label="Gargoyle Male" equipment_offset=50000 body=666 canvas_width=300 canvas_height=340 body_x=0 body_y=0 equipment_x=0 equipment_y=0
profile "gargoyle_female" label="Gargoyle Female" equipment_offset=60000 fallback_equipment_offset=50000 body=667 canvas_width=300 canvas_height=340 body_x=0 body_y=0 equipment_x=0 equipment_y=0
